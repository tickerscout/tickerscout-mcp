{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tickerscout-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs are OFF on purpose (2026-08-26). With them on, Cloudflare
  // automatically captures request metadata AND HEADERS on every call, which
  // includes CF-Connecting-IP, retained 3 days on the Workers free plan. The
  // privacy policy promises that we never receive or store visitor IP
  // addresses, and this endpoint is in its scope, so that promise and
  // invocation logging cannot both be true. Uncaught exceptions are still
  // logged (they describe what failed, not who asked), and src/ emits no
  // console.log, so nothing useful is lost. Do not re-enable without
  // changing privacy.html first.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  // workers.dev stays on: /mcp is not an indexable page, so a second hostname
  // costs nothing, and it is a useful target for testing a deploy before the
  // custom domain picks it up.
  "workers_dev": true

  // No "routes" key. mcp.tickerscout.ai is attached to this Worker as a custom
  // domain, which wrangler leaves alone.
}
